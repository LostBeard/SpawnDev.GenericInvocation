<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Turn on the trim + AOT analyzers so this library owns its own reflection warnings.
		     The public API is honestly labelled with [RequiresUnreferencedCode]/[RequiresDynamicCode];
		     those attributes make the internal reflection warnings go away here and surface a single
		     actionable warning at each consumer call site instead of an opaque IL20xx deep inside us. -->
		<IsTrimmable>true</IsTrimmable>
		<IsAotCompatible>true</IsAotCompatible>
		<Version>1.0.1</Version>
		<PackageReleaseNotes>v1.0.1 - Trimming support</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.GenericInvocation</Title>
		<Authors>LostBeard</Authors>
		<Description>A high-performance reflection utility for **.NET 8, 9, and 10** that bridges the gap between runtime `Type` variables and compile-time generic (`T`) method signatures.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.GenericInvocation</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.GenericInvocation.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Reflection;Generics;MethodInvoker;Expression-Trees</PackageTags>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
